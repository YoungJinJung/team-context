+describe("McpStack - gateway routing", () => {
+  function synth(gatewayArn: unknown, gatewayTarget: unknown): Template {
+    const app = new cdk.App({ context: { ...TEST_CONTEXT, team_context_gateway_arn: gatewayArn, team_context_gateway_target: gatewayTarget } });
+    const deps = new cdk.Stack(app, "RouteDeps", { env: { account: "123456789012", region: "us-east-1" } });
