+    const table = (name: string) => new dynamodb.Table(deps, name, { partitionKey: { name: "PK", type: dynamodb.AttributeType.STRING } });
+    return Template.fromStack(new McpStack(app, "RouteMcp", {
+      env: { account: "123456789012", region: "us-east-1" }, vpc,
+      rolesTable: table("Roles"), resourceRoleMappingsTable: table("RRM"),
+    }));
+  }
+
+  it("routes execution through the configured gateway without a direct runtime ARN", () => {
+    const template = synth(TEST_CONTEXT.team_context_gateway_arn, "ContextManager");
+    template.hasResourceProperties("AWS::BedrockAgentCore::Runtime", {
+      EnvironmentVariables: Match.objectLike({
+        CM_GATEWAY_ARN: TEST_CONTEXT.team_context_gateway_arn,
+        CM_GATEWAY_TARGET: "ContextManager",
+        CM_GATEWAY_ACCOUNT: "123456789012",
+        CM_RUNTIME_ARN: Match.absent(),
+      }),
+    });
+  });
+
+  it.each([
+    [undefined, "ContextManager"],
+    ["arn:aws:bedrock-agentcore:us-east-1:123456789012:gateway/*", "ContextManager"],
+    ["arn:aws:bedrock-agentcore:us-west-2:123456789012:gateway/tc-0123456789", "ContextManager"],
+    ["arn:aws:bedrock-agentcore:us-east-1:999999999999:gateway/tc-0123456789", "ContextManager"],
+    ["arn:aws-cn:bedrock-agentcore:us-east-1:123456789012:gateway/tc-0123456789", "ContextManager"],
+    [TEST_CONTEXT.team_context_gateway_arn, undefined],
+    [TEST_CONTEXT.team_context_gateway_arn, "../escape"],
+  ])("rejects unsafe gateway configuration: %s %s", (gatewayArn, target) => {
+    expect(() => synth(gatewayArn, target)).toThrow("Invalid Context Manager gateway configuration");
+  });
+});
