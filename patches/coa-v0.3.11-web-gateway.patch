+// Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+import { act, renderHook } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { invokeAgentCore } from "@utils/invoke-agentcore";
+import { usePlaygroundStream } from "../../../src/api-hooks/use-playground-stream";
+
+vi.mock("@auth", () => ({ OIDCProvider: { build: () => ({ getIdToken: async () => "test-token", getUser: async () => ({ profile: { sub: "user-123" } }) }) } }));
+const endpoint = "https://gateway.example.test/query/invocations";
+const oidcConfig = { authority: "https://idp.example.test", clientId: "client" };
+afterEach(() => vi.unstubAllGlobals());
+describe("Gateway requests", () => {
+  it("sends session and caller token without following redirects in the shared client", async () => {
+    const fetchMock = vi.fn().mockResolvedValue(new Response('data: {"ok":true}\n\n', { status: 200 }));
+    vi.stubGlobal("fetch", fetchMock);
+    expect(await invokeAgentCore({ queryEndpoint: endpoint, oidcConfig, payload: { query: "hello" } })).toEqual({ ok: true });
+    expect(fetchMock).toHaveBeenCalledWith(endpoint, expect.objectContaining({ redirect: "error", headers: expect.objectContaining({ Authorization: "Bearer test-token", "X-Amzn-Bedrock-AgentCore-Runtime-Session-Id": expect.any(String) }) }));
+  });
+  it("sends session and caller token without following redirects in the streaming client", async () => {
+    const fetchMock = vi.fn().mockResolvedValue(new Response("", { status: 200 }));
+    vi.stubGlobal("fetch", fetchMock);
+    const { result } = renderHook(() => usePlaygroundStream({ queryEndpoint: endpoint, oidcConfig, onEvent: vi.fn() }));
+    await act(async () => { await result.current.submit({ query: "hello", namespace: "default", requestId: "r1" }); });
+    expect(fetchMock).toHaveBeenCalledWith(endpoint, expect.objectContaining({ redirect: "error", headers: expect.objectContaining({ Authorization: "Bearer test-token", "X-Amzn-Bedrock-AgentCore-Runtime-Session-Id": expect.any(String) }) }));
+  });
+});
