+// Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+import { describe, expect, it } from "vitest";
+import { buildQueryEndpoint } from "@utils/build-query-endpoint";
+
+const valid = { region: "us-east-1", serveGatewayArn: "arn:aws:bedrock-agentcore:us-east-1:123456789012:gateway/team-0123456789", serveGatewayAccount: "123456789012", serveGatewayTarget: "query-target" };
+describe("Gateway query endpoint", () => {
+  it("constructs only the configured gateway target", () => {
+    expect(buildQueryEndpoint(valid)).toBe("https://team-0123456789.gateway.bedrock-agentcore.us-east-1.amazonaws.com/query-target/invocations");
+  });
+  it("uses the China partition suffix", () => {
+    expect(buildQueryEndpoint({ ...valid, region: "cn-north-1", serveGatewayArn: "arn:aws-cn:bedrock-agentcore:cn-north-1:123456789012:gateway/team-0123456789" })).toBe("https://team-0123456789.gateway.bedrock-agentcore.cn-north-1.amazonaws.com.cn/query-target/invocations");
+  });
+  it.each([
+    undefined,
+    { region: "us-east-1", serveRuntimeArn: "arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/legacy" },
+    { ...valid, serveGatewayArn: undefined },
+    { ...valid, serveGatewayAccount: "999999999999" },
+    { ...valid, region: "us-west-2" },
+    { ...valid, serveGatewayTarget: "evil/path" },
+    { ...valid, serveGatewayTarget: "query-target\n" },
+    { ...valid, serveGatewayArn: valid.serveGatewayArn + "\n" },
+    { ...valid, serveGatewayArn: valid.serveGatewayArn.replace("arn:aws:", "arn:aws-cn:") },
+  ])("rejects invalid configuration %#", (config) => {
+    expect(buildQueryEndpoint(config)).toBeUndefined();
+  });
+});
