+      serveGatewayArn: gateway, serveGatewayTarget: "ContextManager", serveGatewayAccount: "123456789012",
+    });
+    expect(cfg).toMatchObject({ serveGatewayArn: gateway, serveGatewayTarget: "ContextManager", serveGatewayAccount: "123456789012" });
