+    const app = new cdk.App({ context: { ...context, ...overrides } });
+    return Template.fromStack(new WebStack(app, "GatewayWeb", {
+      ...BASE_PROPS, env: { account: "123456789012", region: "us-east-1" },
+      serveRuntimeArn: runtime, contentSecurityPolicy: customPolicy,
+    }));
+  }
+
+  test("passes configured gateway settings to runtime config without a direct ARN", () => {
+    const cfg = buildRuntimeConfig({
