+def _gateway_url(gateway_arn: str, target: str, account: str, region: str) -> str:
+    """Build only the configured, same-account AgentCore Gateway target URL."""
+    arn = re.fullmatch(
+        r"arn:(aws|aws-cn|aws-us-gov):bedrock-agentcore:([a-z0-9-]+):([0-9]{12}):gateway/((?:[0-9a-z]-?){1,100}-[0-9a-z]{10})",
+        gateway_arn,
+    ) if isinstance(gateway_arn, str) else None
+    valid_region = isinstance(region, str) and re.fullmatch(r"[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+", region)
+    valid_target = isinstance(target, str) and re.fullmatch(r"(?:[0-9a-zA-Z]-?){1,100}", target)
+    if not arn or not valid_region or not valid_target or arn.group(2) != region or arn.group(3) != account:
+        raise ValueError("Invalid Context Manager gateway configuration")
+    partition = arn.group(1)
+    if (partition == "aws-cn") != region.startswith("cn-") or (partition == "aws-us-gov") != region.startswith("us-gov-"):
+        raise ValueError("Invalid Context Manager gateway configuration")
+    suffix = "amazonaws.com.cn" if partition == "aws-cn" else "amazonaws.com"
+    return f"https://{arn.group(4)}.gateway.bedrock-agentcore.{region}.{suffix}/{target}/invocations"
