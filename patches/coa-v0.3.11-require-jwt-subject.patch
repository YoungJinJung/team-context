diff --git a/packages/context-manager/tests/unit/test_jwt_subject_gate.py b/packages/context-manager/tests/unit/test_jwt_subject_gate.py
new file mode 100644
index 0000000..fe38c5e
--- /dev/null
+++ b/packages/context-manager/tests/unit/test_jwt_subject_gate.py
@@ -0,0 +1,64 @@
+# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Check the runtime's fail-closed forwarded JWT subject boundary."""
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import jwt
+import pytest
+from coa_serve import main
+
+
+def context_for(sub):
+    token = jwt.encode({"sub": sub}, "x" * 32, algorithm="HS256")
+    return SimpleNamespace(request_headers={"Authorization": "Bearer " + token})
+
+
+async def invoke(payload, context):
+    return [item async for item in main.invoke(payload, context)]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("action", ["query", "translate", "kbSearch", "graphTraverse", "getRecentSession", "getSessionHistory", "createSession", "listSessions", "deleteSession"])
+@pytest.mark.parametrize("context", [None, SimpleNamespace(request_headers={}), SimpleNamespace(request_headers={"Authorization": "Bearer bad"}), context_for(None), context_for(""), context_for(" "), context_for(123), context_for([]), context_for("a" * 256), context_for("bad\nsubject")])
+async def test_missing_subject_denies_before_initialization_or_payload_identity(monkeypatch, action, context):
+    init = AsyncMock()
+    monkeypatch.setattr(main, "_ensure_initialized", init)
+    payload = {"action": action, "namespace": "victim", "query": "secret", "profile": {"userId": "admin", "groups": ["admin"]}}
+    output = await invoke(payload, context)
+    assert len(output) == 1
+    assert output[0]["statusCode"] == 403
+    assert output[0]["error"] == "AccessDeniedError"
+    assert "admin" not in str(output)
+    init.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_streaming_denial_is_a_typed_event_before_initialization(monkeypatch):
+    init = AsyncMock()
+    monkeypatch.setattr(main, "_ensure_initialized", init)
+    output = await invoke({"query": "secret", "stream": True, "requestId": "req-1"}, None)
+    event = output[0]
+    assert event.get("type") == "error"
+    assert event["requestId"] == "req-1"
+    assert event["payload"] == {"error": "AccessDenied", "message": "Authentication required", "statusCode": 403}
+    init.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_forwarded_subject_reaches_existing_initialization(monkeypatch):
+    init = AsyncMock(side_effect=RuntimeError("stop here"))
+    monkeypatch.setattr(main, "_ensure_initialized", init)
+    output = await invoke({"query": "hello"}, context_for("alice"))
+    assert output[0]["error"] == "InternalError"
+    init.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("payload", [None, [], "bad"])
+async def test_malformed_payload_denies_before_initialization(monkeypatch, payload):
+    init = AsyncMock()
+    monkeypatch.setattr(main, "_ensure_initialized", init)
+    output = await invoke(payload, context_for("alice"))
+    assert output[0]["statusCode"] == 403
+    init.assert_not_awaited()
