+
+describe("ontology proxy lockdown", () => {
+  const template = renderOntology({}, "OntologyLockdown");
+  const resources = template.toJSON().Resources;
+  const proxy = Object.values(resources).find((r: any) =>
+    r.Type === "AWS::Lambda::Function" && String(r.Properties.FunctionName).endsWith("-ontology-api-proxy"),
+  ) as any;
+
+  it("denies direct requests for every method and path", () => {
+    expect(proxy).toBeDefined();
+    expect(proxy.Properties.Handler).toBe("index.handler");
+    const code = proxy.Properties.Code.ZipFile;
+    expect(typeof code).toBe("string");
+    const probe = `${code}\nimport json\nevents = [None, "malformed", [], {}, {"httpMethod": "GET", "resource": "/namespaces/{namespaceId}/graph/search"}, {"httpMethod": "POST", "resource": "/namespaces/{namespaceId}/embeddings/search"}, {"httpMethod": "GET", "resource": "/namespaces/{namespaceId}/ontologies/{ontologyId}/download"}, {"httpMethod": "DELETE", "resource": "/namespaces/{namespaceId}/ontologies"}]\nprint(json.dumps([handler(e, None) for e in events]))`;
+    const output = JSON.parse(execFileSync("python3", ["-c", probe], { encoding: "utf8" }));
+    expect(output).toHaveLength(8);
+    for (const result of output) {
+      expect(result.statusCode).toBe(403);
+      expect(JSON.parse(result.body)).toEqual({ message: "Ontology API is disabled" });
+    }
+  });
+
+  it("has no VPC access, application secrets or extra role policies", () => {
+    expect(proxy.Properties.VpcConfig).toBeUndefined();
+    expect(proxy.Properties.Environment).toBeUndefined();
+    const roleId = proxy.Properties.Role["Fn::GetAtt"][0];
+    const role = resources[roleId];
+    expect(role.Type).toBe("AWS::IAM::Role");
+    expect(role.Properties.Policies).toBeUndefined();
+    expect(JSON.stringify(role.Properties.ManagedPolicyArns)).toContain("AWSLambdaBasicExecutionRole");
+    expect(role.Properties.ManagedPolicyArns).toHaveLength(1);
+    for (const resource of Object.values(resources) as any[]) {
+      if (resource.Type === "AWS::IAM::Policy") {
+        expect(JSON.stringify(resource.Properties.Roles)).not.toContain(`"${roleId}"`);
+      }
+    }
+  });
+});
